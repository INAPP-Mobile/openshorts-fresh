# OpenShorts environment variables
# Copy to .env (local) or set on Railway. Secrets are shown as placeholders.

# ── HTTP ────────────────────────────────────────────────────────────────
# Port uvicorn listens on. Railway injects its own PORT and routes the public
# domain here, so leave this for Railway to set (defaults to 8000 in the image).
PORT=8000

# ── Required ────────────────────────────────────────────────────────────
# RapidAPI key for the youtube-mp41 downloader (YouTube URL jobs).
# https://rapidapi.com/ytjar/api/youtube-mp41  (free tier works)
RAPIDAPI_KEY=your_rapidapi_key_here

# Google Gemini API key for AI analysis (clip detection, titles, thumbnails,
# voice-over). https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Optional: concurrency ───────────────────────────────────────────────
# Max parallel video jobs. Each is CPU/RAM heavy; keep low on small plans.
MAX_CONCURRENT_JOBS=2

# ── Optional: S3 upload of generated clips ──────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-3
AWS_S3_BUCKET=
AWS_S3_PUBLIC_BUCKET=

# ── Internal paths (managed by the image / Railway volume, rarely edited) ─
# OUTPUT_DIR  — directory for generated videos/thumbnails (volume)
# UPLOAD_DIR  — directory for uploaded source videos (volume)
# DIST_DIR    — path to the pre-built dashboard
OUTPUT_DIR=/data/output
UPLOAD_DIR=/data/uploads
DIST_DIR=/app/dist
